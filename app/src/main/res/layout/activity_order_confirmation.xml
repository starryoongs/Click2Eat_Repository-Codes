<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDE1EB"
    android:orientation="vertical">

    <!-- Header (matches HomeActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:contentDescription="Menu"
            android:src="@drawable/three_line_icon" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:contentDescription="Click2Eat logo"
            android:scaleType="fitCenter"
            android:src="@drawable/click2eat_logo_no_bg" />

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginEnd="13dp"
            android:background="@drawable/bg_profile_circle"
            android:clipToOutline="true"
            android:contentDescription="Open profile"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile2" />
    </LinearLayout>

    <!-- White Confirmation Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_profile_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Order placed"
            android:src="@drawable/ic_order_check" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Order Placed!"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your order has been placed successfully. Thank you for ordering with Click2Eat!"
            android:textColor="#666666"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#F5D0E0" />

        <!-- Order ID Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order ID"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConfirmOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#000001"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Restaurant Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restaurant"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConfirmRestaurant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="McDo - Fastfood"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Total Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConfirmTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Order Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order Status"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConfirmStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="#FF8C42"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnViewOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:text="View Order Details"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/click_pink"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Bottom Navigation (matches HomeActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/click_white"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/dashboard_icon" />

        <ImageButton
            android:id="@+id/btnCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/btnRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Restaurants"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/restaurants_icon" />

        <ImageButton
            android:id="@+id/btnOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Order history"
            android:padding="21dp"
            android:scaleType="centerInside"
            android:src="@drawable/history_icon" />
    </LinearLayout>
</LinearLayout>