<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDE1EB">

    <!-- Header (matches HomeActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:contentDescription="Menu"
            android:src="@drawable/three_line_icon" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:contentDescription="Click2Eat logo"
            android:scaleType="fitCenter"
            android:src="@drawable/click2eat_logo_no_bg" />

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginEnd="13dp"
            android:background="@drawable/bg_profile_circle"
            android:clipToOutline="true"
            android:contentDescription="Open profile"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile2" />
    </LinearLayout>

    <!-- Back Button and Title -->
    <LinearLayout
        android:id="@+id/btnBackCheckout"
        android:layout_width="392dp"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Back to cart"
            android:scaleType="fitCenter"
            android:src="@drawable/arrow_left" />

        <TextView
            android:layout_width="103dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="Checkout"
            android:textColor="#555555"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- White Checkout Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_restaurant_cart"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Restaurant Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRestaurantLogo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="Restaurant logo"
                android:scaleType="fitCenter"
                android:src="@drawable/click2eat_logo_no_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="McDo - Fastfood"
                    android:textColor="#111111"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeliveryTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="20-30 mins"
                    android:textColor="#555555"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRestaurantOptions"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:contentDescription="Restaurant cart options"
                android:focusable="true"
                android:gravity="center"
                android:text="•••"
                android:textColor="#555555"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Scrollable Order Items & Delivery Fields -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llOrderItemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F3D6E2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Delivery Information"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDeliveryAddress"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_pink_input"
                    android:hint="Enter complete delivery address"
                    android:inputType="textPostalAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etContactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_pink_input"
                    android:hint="Enter contact number (e.g., 09171234567)"
                    android:inputType="phone"
                    android:maxLength="13"
                    android:paddingHorizontal="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total:"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pink Outlined Place Order Button (Matches Mockup) -->
        <TextView
            android:id="@+id/btnPlaceOrder"
            android:layout_width="165dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_pink_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Place Order"
            android:textColor="#F477B3"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fixed Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/click_white"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/dashboard_icon" />

        <ImageButton
            android:id="@+id/btnCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/btnRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Restaurants"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/restaurants_icon" />

        <ImageButton
            android:id="@+id/btnOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Order history"
            android:padding="21dp"
            android:scaleType="centerInside"
            android:src="@drawable/history_icon" />

    </LinearLayout>
</LinearLayout>