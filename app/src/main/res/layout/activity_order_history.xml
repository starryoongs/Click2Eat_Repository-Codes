<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDE1EB">

    <!-- Header (matches HomeActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ordersBackButton"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:contentDescription="Menu"
            android:src="@drawable/three_line_icon" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:contentDescription="Click2Eat logo"
            android:scaleType="fitCenter"
            android:src="@drawable/click2eat_logo_no_bg" />

        <ImageView
            android:id="@+id/ordersProfile"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginEnd="13dp"
            android:background="@drawable/bg_profile_circle"
            android:clipToOutline="true"
            android:contentDescription="Open profile"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile2" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text="Order History"
        android:textColor="#555555"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Status Filter -->
    <Spinner
        android:id="@+id/orderStatusFilter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_profile_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:contentDescription="Filter orders by status" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/orderHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No orders to show yet."
        android:textColor="@color/click_text"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Order List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/orderHistoryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/click_white">

        <ImageButton
            android:id="@+id/ordersNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/dashboard_icon"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/ordersNavCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/cart_icon"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:contentDescription="Cart" />

        <ImageButton
            android:id="@+id/ordersNavRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/restaurants_icon"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:contentDescription="Restaurants" />

        <ImageButton
            android:id="@+id/ordersNavOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/history_icon"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:contentDescription="Order History" />

    </LinearLayout>

</LinearLayout>