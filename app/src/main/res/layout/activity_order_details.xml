<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDE1EB"
    android:orientation="vertical">

    <!-- Click2Eat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/orderDetailsMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:contentDescription="Back to orders"
            android:src="@drawable/three_line_icon" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:contentDescription="Click2Eat logo"
            android:scaleType="fitCenter"
            android:src="@drawable/click2eat_logo_no_bg" />

        <ImageView
            android:id="@+id/orderDetailsProfile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile2" />

    </LinearLayout>

    <!-- Order Details Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="Order Details"
        android:textColor="#555555"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Back to Orders: Outside White Card -->
    <LinearLayout
        android:id="@+id/orderDetailsBackButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Back to Orders">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:rotation="180"
            android:src="@drawable/arrow_right"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Orders"
            android:textColor="#555555"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable Order Information -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:orientation="vertical">

            <!-- White Order Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Restaurant Information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgDetailsRestaurant"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Restaurant logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/click2eat_logo_no_bg" />

                    <TextView
                        android:id="@+id/orderDetailsHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/click_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Order Status -->
                <TextView
                    android:id="@+id/orderDetailsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/click_pink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Order Date -->
                <TextView
                    android:id="@+id/orderDetailsDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#666666"
                    android:textSize="13sp" />

                <!-- Delivery Address -->
                <TextView
                    android:id="@+id/orderDetailsAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <!-- Contact Number -->
                <TextView
                    android:id="@+id/orderDetailsContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <!-- Items Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Items"
                    android:textColor="@color/click_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Food Items -->
                <LinearLayout
                    android:id="@+id/orderDetailsItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Order Total -->
                <TextView
                    android:id="@+id/orderDetailsTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="end"
                    android:textColor="@color/click_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Cancel Order -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/cancelOrderButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pink_button"
                    android:stateListAnimator="@null"
                    android:text="Cancel Order"
                    android:textAllCaps="false"
                    android:textColor="@color/click_white"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/click_white"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/detailsNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/dashboard_icon" />

        <ImageButton
            android:id="@+id/detailsNavCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/detailsNavRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Restaurants"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/restaurants_icon" />

        <ImageButton
            android:id="@+id/detailsNavOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Order History"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/history_icon" />

    </LinearLayout>

</LinearLayout>
