<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/click_profile_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_profile_card">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/orderDetailsBackButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_outline_button"
                android:stateListAnimator="@null"
                android:text="← Back to orders"
                android:textAllCaps="false"
                android:textColor="@color/click_pink" />

            <TextView
                android:id="@+id/orderDetailsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Order details"
                android:textColor="@color/click_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderDetailsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/click_pink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderDetailsDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/click_text" />

            <TextView
                android:id="@+id/orderDetailsAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/click_text" />

            <TextView
                android:id="@+id/orderDetailsContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/click_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Items"
                android:textColor="@color/click_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/orderDetailsItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/orderDetailsTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/click_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancelOrderButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pink_button"
                android:text="Cancel order"
                android:textAllCaps="false"
                android:textColor="@color/click_white"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
