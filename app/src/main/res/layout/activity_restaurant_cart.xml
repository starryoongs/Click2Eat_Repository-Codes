<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCE3EC">

    <!-- Click2Eat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☰"
            android:textSize="32sp"
            android:contentDescription="Open menu" />

        <TextView
            android:id="@+id/txtLogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Click2Eat"
            android:textColor="#F477B3"
            android:textStyle="bold|italic"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/btnProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="●"
            android:textColor="#F477B3"
            android:textSize="30sp"
            android:contentDescription="Profile" />

    </LinearLayout>

    <!-- Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="28sp"
            android:contentDescription="Back to all carts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cart"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#555555" />

    </LinearLayout>

    <!-- White Restaurant Cart Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_restaurant_cart"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Restaurant Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgRestaurant"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Restaurant logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtRestaurantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="McDo - Fastfood"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/txtDeliveryTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="20-30 mins"
                    android:textSize="14sp"
                    android:textColor="#555555" />

            </LinearLayout>

            <TextView
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⋯"
                android:textSize="28sp" />

        </LinearLayout>

        <!-- Selected Food Items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCartItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:clipToPadding="false" />

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/txtCartTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱473.00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111" />

        </LinearLayout>

        <!-- Checkout Button -->
        <TextView
            android:id="@+id/btnProceedCheckout"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pink_outline"
            android:gravity="center"
            android:text="Proceed to Checkout"
            android:textSize="15sp"
            android:textColor="#F477B3"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#F477B3" />

        <TextView
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cart"
            android:textStyle="bold"
            android:textColor="#F477B3" />

        <TextView
            android:id="@+id/navRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Restaurants"
            android:textColor="#F477B3" />

        <TextView
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Orders"
            android:textColor="#F477B3" />

    </LinearLayout>

</LinearLayout>
