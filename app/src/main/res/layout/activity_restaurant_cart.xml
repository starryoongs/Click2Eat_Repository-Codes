<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDE1EB">

    <!-- Header (matches HomeActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="71dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:layout_marginLeft="9dp"
            android:contentDescription="Menu"
            android:src="@drawable/three_line_icon" />

        <ImageView
            android:id="@+id/imgClick2EatLogo"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:contentDescription="Click2Eat logo"
            android:scaleType="fitCenter"
            android:src="@drawable/click2eat_logo_no_bg" />

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginEnd="13dp"
            android:background="@drawable/bg_profile_circle"
            android:clipToOutline="true"
            android:contentDescription="Open profile"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile2" />
    </LinearLayout>

    <!-- Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/arrow_left"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back to all carts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="Cart"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#555555" />

    </LinearLayout>

    <!-- White Restaurant Cart Card -->
    <LinearLayout
        android:layout_width="354dp"
        android:layout_height="0dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_restaurant_cart"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Restaurant Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgRestaurant"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="Restaurant logo"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtRestaurantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="McDo - Fastfood"
                    android:textColor="#111111"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDeliveryTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="20-30 mins"
                    android:textColor="#555555"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnRestaurantOptions"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:contentDescription="Restaurant cart options"
                android:focusable="true"
                android:gravity="center"
                android:text="•••"
                android:textColor="#555555"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Scrollable Food Items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCartItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total:"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCartTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱473.00"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Checkout Button -->
        <TextView
            android:id="@+id/btnProceedCheckout"
            android:layout_width="165dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pink_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Proceed to Checkout"
            android:textColor="#F477B3"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Fixed Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/click_white"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/dashboard_icon" />

        <ImageButton
            android:id="@+id/btnCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/btnRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Restaurants"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/restaurants_icon" />

        <ImageButton
            android:id="@+id/btnOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Order history"
            android:padding="21dp"
            android:scaleType="centerInside"
            android:src="@drawable/history_icon" />

    </LinearLayout>

</LinearLayout>