<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCE3EC">

    <!-- Click2Eat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☰"
            android:textColor="#555555"
            android:textSize="32sp"
            android:contentDescription="Open menu" />

        <ImageView
            android:id="@+id/imgClick2EatLogo"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:src="@drawable/click2eat_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Click2Eat logo" />

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_profile"
            android:scaleType="fitCenter"
            android:contentDescription="Profile" />

    </LinearLayout>

    <!-- Back Button and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_back_arrow"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back to all carts" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cart"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#555555" />

    </LinearLayout>

    <!-- White Restaurant Cart Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_restaurant_cart"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Restaurant Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgRestaurant"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Restaurant logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtRestaurantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="McDo - Fastfood"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <TextView
                    android:id="@+id/txtDeliveryTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="20-30 mins"
                    android:textSize="14sp"
                    android:textColor="#555555" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnRestaurantOptions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="•••"
                android:textSize="20sp"
                android:textColor="#555555"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Restaurant cart options" />

        </LinearLayout>

        <!-- Scrollable Food Items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCartItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:clipToPadding="false" />

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/txtCartTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱473.00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111111" />

        </LinearLayout>

        <!-- Checkout Button -->
        <TextView
            android:id="@+id/btnProceedCheckout"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pink_outline"
            android:gravity="center"
            android:text="Proceed to Checkout"
            android:textSize="15sp"
            android:textColor="#F477B3"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Fixed Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="Home" />

        <ImageView
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:src="@drawable/ic_nav_cart"
            android:contentDescription="Cart" />

        <ImageView
            android:id="@+id/navRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:src="@drawable/ic_nav_restaurants"
            android:contentDescription="Restaurants" />

        <ImageView
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="18dp"
            android:src="@drawable/ic_nav_orders"
            android:contentDescription="Order History" />

    </LinearLayout>

</LinearLayout>
