<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivMenuItem"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:contentDescription="Food image"
        android:scaleType="centerInside"
        android:src="@drawable/click2eat_logo_no_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvMenuName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/click_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMenuDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/click_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMenuPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/click_pink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAddToCart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add"
        android:textAllCaps="false" />

</LinearLayout>