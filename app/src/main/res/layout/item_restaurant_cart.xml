<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_restaurant_cart"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Restaurant Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Restaurant Logo -->
        <ImageView
            android:id="@+id/imgRestaurant"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Restaurant logo" />

        <!-- Restaurant Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRestaurantName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="McDo - Fastfood"
                android:textColor="#111111"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="2" />

            <TextView
                android:id="@+id/txtDeliveryTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="20-30 mins"
                android:textColor="#555555"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Restaurant Options -->
        <TextView
            android:id="@+id/btnRestaurantOptions"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="•••"
            android:textSize="20sp"
            android:textColor="#555555"
            android:contentDescription="Restaurant options" />

    </LinearLayout>

    <!-- Food Image Previews -->
    <LinearLayout
        android:id="@+id/layoutFoodPreviews"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Food images added by RestaurantCartAdapter -->

    </LinearLayout>

    <!-- Restaurant Subtotal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Subtotal:"
            android:textColor="#555555"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRestaurantSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱400.00"
            android:textColor="#555555"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- View Cart Button -->
    <TextView
        android:id="@+id/btnViewCart"
        android:layout_width="165dp"
        android:layout_height="35dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pink_outline"
        android:gravity="center"
        android:text="View your cart"
        android:textColor="#F477B3"
        android:textSize="12sp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="View restaurant cart" />

</LinearLayout>