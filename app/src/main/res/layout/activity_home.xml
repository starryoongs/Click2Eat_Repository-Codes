<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDE1EB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="9dp"
                    android:contentDescription="Menu"
                    android:src="@drawable/three_line_icon" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:contentDescription="Click2Eat logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/click2eat_logo_no_bg" />

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/bg_profile_circle"
                    android:clipToOutline="true"
                    android:contentDescription="Open profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_profile2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="41dp"
                android:layout_marginTop="18dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_profile_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Search icon"
                    android:src="@drawable/search_icon" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search..."
                    android:paddingStart="12dp"
                    android:singleLine="true"
                    android:textSize="16dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="122dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_profile_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Hi, "
                        android:textColor="@color/click_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="10dp"
                        android:text="What do you feel like\neating today?"
                        android:textColor="@color/click_text"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="210dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="20dp"
                    android:contentDescription="Click2Eat mascot"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="370dp"
                android:layout_height="45dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="-20dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="370dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1"
                    android:text="Restaurants"
                    android:textColor="#555555"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/tvSeeRestaurants"
                    android:layout_width="35dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginRight="15dp"
                    android:contentDescription="See More.."
                    android:gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrow_right" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeaturedRestaurants"
                android:layout_width="360dp"
                android:layout_marginLeft="5dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Orders"
                    android:textColor="#555555"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSeeRecentOrders"
                    android:layout_width="20dp"
                    android:layout_height="33dp"
                    android:layout_marginRight="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="See recent orders"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrow_right" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="345dp"
                android:layout_height="145dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="10dp"
                android:background="#F8C5D3"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/click_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_marginLeft="8dp"
                        android:contentDescription="Recent order restaurant"
                        android:scaleType="centerInside"
                        android:src="@drawable/tokyo_tokyo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tokyo Tokyo"
                            android:textColor="@color/click_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="20-30 mins"
                            android:textColor="@color/click_text"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Beverage, Japanese"
                            android:textColor="@color/click_text"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:layout_marginLeft="8dp"
                android:text="Categories"
                android:textColor="#555555"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="360dp"
                android:layout_height="220dp"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/click_white"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Home"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/dashboard_icon" />

        <ImageButton
            android:id="@+id/btnCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/cart_icon" />

        <ImageButton
            android:id="@+id/btnRestaurants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Restaurants"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/restaurants_icon" />

        <ImageButton
            android:id="@+id/btnOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Order history"
            android:padding="21dp"
            android:scaleType="centerInside"
            android:src="@drawable/history_icon" />

    </LinearLayout>
</LinearLayout>