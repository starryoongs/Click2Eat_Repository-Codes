<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Restaurant Information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgOrderRestaurant"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Restaurant logo"
            android:scaleType="fitCenter"
            android:src="@drawable/click2eat_logo_no_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderRestaurant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/click_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="McDo" />

            <TextView
                android:id="@+id/tvOrderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#777777"
                android:textSize="12sp"
                tools:text="November 23, 2026" />

        </LinearLayout>
    </LinearLayout>

    <!-- Order Status -->
    <TextView
        android:id="@+id/tvOrderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/click_pink"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Status: Completed" />

    <!-- Food Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgOrderFood"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Ordered food"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/tvOrderItems"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="4"
            android:textColor="#555555"
            android:textSize="14sp"
            tools:text="Big Mac × 1" />
    </LinearLayout>

    <!-- Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total:"
            android:textColor="@color/click_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/click_text"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="₱199.00" />

    </LinearLayout>

    <!-- View Details -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnViewOrderDetails"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pink_button"
        android:stateListAnimator="@null"
        android:text="View Order Details"
        android:textAllCaps="false"
        android:textColor="@color/click_white"
        android:textSize="15sp" />

</LinearLayout>
