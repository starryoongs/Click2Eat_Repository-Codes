<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Click2Eat">

        <!-- Login Screen -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Registration -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <!-- Profile -->
        <activity
            android:name=".auth.ProfileActivity"
            android:exported="false" />

        <!-- Restaurant Cart Details -->
        <activity
            android:name=".RestaurantCartActivity"
            android:exported="false" />

        <!-- All Carts -->
        <activity
            android:name=".CartActivity"
            android:exported="false" />

        <!-- Checkout -->
        <activity
            android:name=".checkout.CheckoutActivity"
            android:exported="false" />

        <!-- Order Confirmation -->
        <activity
            android:name=".checkout.OrderConfirmationActivity"
            android:exported="false" />

        <!-- Home and Restaurant Screens -->
        <activity
            android:name=".home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".home.RestaurantsActivity"
            android:exported="false" />

        <activity
            android:name=".home.RestaurantActivity"
            android:exported="false" />

        <activity
            android:name=".home.SearchActivity"
            android:exported="false" />

    </application>

</manifest>